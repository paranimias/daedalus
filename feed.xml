---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <description>{{ site.description | xml_escape }}</description>
    <link>{{ site.url }}{{ site.baseurl }}/</link>
    <atom:link href="{{ "/feed.xml" | prepend: site.baseurl | prepend: site.url }}" rel="self" type="application/rss+xml" />
    <pubDate>{{ site.time | date_to_rfc822 }}</pubDate>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    <generator>Jekyll v{{ jekyll.version }}</generator>
    {% for post in site.posts limit:10 %}
      {% assign es_content = post.content | split: '<div class="en post-container">' | first %}
      {% assign post_link = post.url | prepend: site.baseurl | prepend: site.url %}
      {% comment %} MathJax needs JS, which feed readers don't run: posts with LaTeX get an excerpt + link instead of the full body. {% endcomment %}
      {% if post.mathjax %}
        {% capture feed_body %}<p>{{ es_content | strip_html | strip_newlines | truncatewords: 60 }}</p><p><em>Esta entrada contiene fórmulas matemáticas que no se muestran en el lector RSS. <a href="{{ post_link }}">Léela completa en el blog</a>.</em></p>{% endcapture %}
      {% else %}
        {% assign feed_body = es_content %}
      {% endif %}
      <item>
        <title>{{ post.title | xml_escape }}</title>
        <description>{{ feed_body | xml_escape }}</description>
        <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
        <link>{{ post.url | prepend: site.baseurl | prepend: site.url }}</link>
        <guid isPermaLink="true">{{ post.url | prepend: site.baseurl | prepend: site.url }}</guid>
        {% for tag in post.tags %}
        <category>{{ tag | xml_escape }}</category>
        {% endfor %}
        {% for cat in post.categories %}
        <category>{{ cat | xml_escape }}</category>
        {% endfor %}
      </item>
    {% endfor %}
  </channel>
</rss>
